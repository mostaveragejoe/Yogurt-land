# --- Claude (required: analysis + scriptwriting) ---
ANTHROPIC_API_KEY=sk-ant-...
# REELTOON_CLAUDE_MODEL=claude-opus-4-8

# --- Rendering (required unless you only use --skip-render) ---
REPLICATE_API_TOKEN=r8_...
# Text-to-image model for storyboard mode (default):
# REELTOON_IMAGE_MODEL=black-forest-labs/flux-schnell
# Set a text-to-video model to render animated shots instead of stills:
# REELTOON_VIDEO_MODEL=wan-video/wan-2.2-t2v-fast

# --- Voiceover ---
# Any edge-tts voice, list with: edge-tts --list-voices
# REELTOON_TTS_VOICE=en-US-GuyNeural

# --- Style: rubber_hose, saturday_morning, anime, flat_modern, claymation, pixel, or auto
# REELTOON_STYLE=auto

# --- YouTube Shorts ---
# YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
# YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# --- Instagram Reels (Business/Creator account + Graph API app) ---
# IG_USER_ID=1784...
# IG_ACCESS_TOKEN=EAAG...

# --- TikTok (Content Posting API) ---
# TIKTOK_ACCESS_TOKEN=act....

# --- Storage ---
# REELTOON_DATA_DIR=data
