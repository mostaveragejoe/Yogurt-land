; PROTOTYPE - NOT FOR PRODUCTION
; Question: which render backend (MultiMesh vs GridMap) serves ADR-0002's model,
;   and what are the draw-call / video-memory numbers at MVP cutaway scale?
; Date: 2026-07-25

config_version=5

[application]

config/name="TerrainSpikeRender"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#")

[dotnet]

project/assembly_name="TerrainSpikeRender"

[display]

; vsync pins every frame to the display refresh, which would make the criterion-5 fps
; number a property of the monitor rather than the renderer. Also disabled at runtime in
; RenderBench._Ready so a stale config cannot silently invalidate a run.
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
