<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Hollowdeep.Core</RootNamespace>
    <AssemblyName>Hollowdeep.Core</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tests may rig internal store state directly; game code still goes through writers.
         The game assembly sees internals ONLY for the debug console's sanctioned writes. -->
    <InternalsVisibleTo Include="Hollowdeep.Core.Tests" />
    <InternalsVisibleTo Include="Hollowdeep" />
  </ItemGroup>
</Project>
